GESTIONALE_DB_MIGRATOR_PASSWORD=
GESTIONALE_DB_MIGRATOR_PASSWORD_FILE=
GESTIONALE_DB_MIGRATOR_PASSWORD_SECRET_FILE=./secrets/database-migrator-password

GESTIONALE_DB_RUNTIME_USERNAME=gestionale_runtime
GESTIONALE_DB_RUNTIME_PASSWORD=
GESTIONALE_DB_RUNTIME_PASSWORD_FILE=
