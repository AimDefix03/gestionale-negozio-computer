GESTIONALE_DB_BACKUP_USERNAME=gestionale_backup
GESTIONALE_DB_BACKUP_PASSWORD=
GESTIONALE_DB_BACKUP_PASSWORD_FILE=
GESTIONALE_DB_BACKUP_PASSWORD_SECRET_FILE=./secrets/database-backup-password

GESTIONALE_DB_RESTORE_USERNAME=gestionale_restore
GESTIONALE_DB_RESTORE_PASSWORD=
GESTIONALE_DB_RESTORE_PASSWORD_FILE=
GESTIONALE_DB_RESTORE_PASSWORD_SECRET_FILE=./secrets/database-restore-password

GESTIONALE_POSTGRES_PORT=5433
GESTIONALE_BACKEND_PORT=8080
GESTIONALE_MANAGEMENT_PORT=9090
GESTIONALE_FRONTEND_PORT=8081
GESTIONALE_PROMETHEUS_PORT=9091

GESTIONALE_LOG_MAX_SIZE=10m
GESTIONALE_LOG_MAX_FILES=5
GESTIONALE_METRICS_RETENTION=15d

BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_COUNT=30
BACKUP_MAX_AGE_HOURS=26
RESTORE_DRILL_MAX_SECONDS=900

GESTIONALE_SECURITY_SESSION_DURATION_MINUTES=45
GESTIONALE_SECURITY_SESSION_IDLE_TIMEOUT_MINUTES=30
GESTIONALE_SECURITY_SESSION_TOUCH_INTERVAL_SECONDS=60

GESTIONALE_LOGIN_RATE_LIMIT=10r/m
GESTIONALE_LOGIN_RATE_BURST=10
GESTIONALE_LOGIN_RETRY_AFTER_SECONDS=60
GESTIONALE_REGISTER_RATE_LIMIT=5r/m
GESTIONALE_REGISTER_RATE_BURST=5
GESTIONALE_REGISTER_RATE_RETRY_AFTER_SECONDS=60

GESTIONALE_BOOTSTRAP_SUPER_ADMIN_ENABLED=false
GESTIONALE_BOOTSTRAP_SUPER_ADMIN_USERNAME=replace-with-initial-super-admin-username
GESTIONALE_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
