SPRING_PROFILES_ACTIVE=prod

GESTIONALE_DB_URL=jdbc:postgresql://db-host:5432/gestionale
GESTIONALE_DB_USERNAME=gestionale_app
GESTIONALE_DB_PASSWORD=
GESTIONALE_DB_PASSWORD_FILE=/run/secrets/gestionale_db_password
GESTIONALE_MANAGEMENT_PORT=9090

GESTIONALE_BOOTSTRAP_SUPER_ADMIN_ENABLED=false
GESTIONALE_BOOTSTRAP_SUPER_ADMIN_USERNAME=replace-with-initial-admin-username
GESTIONALE_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
GESTIONALE_BOOTSTRAP_SUPER_ADMIN_PASSWORD_FILE=/run/secrets/gestionale_bootstrap_password

GESTIONALE_SECURITY_SESSION_DURATION_MINUTES=45
GESTIONALE_SECURITY_SESSION_IDLE_TIMEOUT_MINUTES=30
GESTIONALE_SECURITY_SESSION_TOUCH_INTERVAL_SECONDS=60
GESTIONALE_SECURITY_CLEANUP_DELAY_MS=900000
GESTIONALE_SECURITY_CLEANUP_INITIAL_DELAY_MS=900000
GESTIONALE_SECURITY_SESSION_RETENTION_DAYS=7
GESTIONALE_SECURITY_LOGIN_ATTEMPT_RETENTION_HOURS=24
